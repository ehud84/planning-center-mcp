# Planning Center API application credentials (required for tools)
PCO_CLIENT_ID=your_client_id_here
PCO_CLIENT_SECRET=your_client_secret_here

# Local Claude Desktop/direct use: stdio
# Hosted/Railway use: streamable-http
MCP_TRANSPORT=streamable-http

# Hosted HTTP config
PORT=8000
# MCP_PUBLIC_URL=https://your-app.up.railway.app

# Strongly recommended for any public hosted deployment.
# Clients must send: Authorization: Bearer <token>
# MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Mobile roster web page (GET /roster).
# Set a PIN to enable the page; viewers must enter it to see the roster.
# Leave unset to keep the page disabled.
ROSTER_PIN=1234
# Optional: pin the cookie-signing secret so logins survive across redeploys
# with the exact same value. If unset, it is derived from ROSTER_PIN +
# PCO_CLIENT_SECRET (stable as long as those don't change).
# ROSTER_COOKIE_SECRET=replace-with-a-long-random-string

# Optional API base overrides. Defaults are service-scoped and usually correct.
# PCO_API_ROOT=https://api.planningcenteronline.com
# PCO_GROUPS_API_BASE=https://api.planningcenteronline.com/groups/v2
# PCO_PEOPLE_API_BASE=https://api.planningcenteronline.com/people/v2
