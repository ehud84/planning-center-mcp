{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bellicose-roster",
  "account_id": "55c94d35c24b4d0b590982a76c23d01a",
  "main": "src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "pco.bellicosechurch.org", "custom_domain": true }],
  "kv_namespaces": [
    { "binding": "ROSTER_KV", "id": "ff0e25b8e4e34d74af3f4fe5c924d7a0" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ROSTER_LEAD_GROUP": "Lead Partners",
    "ROSTER_ELDERS_LIST": "Elders",
    "ROSTER_DEACONS_LIST": "Deacons",
    "ROSTER_EXCLUDED_TEAMS": "[\"Bellicose Parenting Conference: All Assignments\",\"Teachers\",\"Children's Ministry\",\"Hosting Lead Partners\"]"
  }
  // Secrets (wrangler secret put): PCO_CLIENT_ID, PCO_CLIENT_SECRET, ROSTER_PIN, ROSTER_COOKIE_SECRET
}
