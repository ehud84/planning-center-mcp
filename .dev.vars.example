# Copy to .dev.vars for `wrangler dev`. In production use `wrangler secret put <NAME>`.

# Planning Center Personal Access Token (same values as Railway's PCO_CLIENT_ID / PCO_CLIENT_SECRET).
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=

# Roster page PIN, and the secret that signs the login cookie.
ROSTER_PIN=1234
ROSTER_COOKIE_SECRET=dev
